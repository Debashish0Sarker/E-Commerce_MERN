# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB Compass or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/E-commerce

# JWT Secret Key for Authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Secret Code required to register as an Administrator (Optional)
ADMIN_SECRET_CODE=your_admin_secret_code_here

# (Optional) Google Gemini API Key for AI Shopping Assistant
# Get a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
